# Copy to .streamlit/secrets.toml for local use (never commit the real file).
# On Streamlit Community Cloud, paste this content (with real values) into
# App settings -> Secrets.

# ID of the Google Sheet: the long part of its URL,
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
sheet_id = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"

# Shared family password asked once on entry (not case-sensitive).
# Remove this line to disable the password.
app_password = "change-me"

# Contents of the service account JSON key, converted to TOML.
[gcp_service_account]
type = "service_account"
project_id = "my-project-123456"
private_key_id = "0123456789abcdef0123456789abcdef01234567"
private_key = "-----BEGIN PRIVATE KEY-----\nPASTE\nTHE\nKEY\nHERE\n-----END PRIVATE KEY-----\n"
client_email = "cadeaux@my-project-123456.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/cadeaux%40my-project-123456.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
